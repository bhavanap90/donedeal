flowchart TB
    %% Styling
    classDef client fill:#1e293b,stroke:#475569,color:#f8fafc,stroke-width:2px
    classDef gateway fill:#0f766e,stroke:#14b8a6,color:#ffffff,stroke-width:2px
    classDef service fill:#1d4ed8,stroke:#3b82f6,color:#ffffff,stroke-width:2px
    classDef infra fill:#4338ca,stroke:#6366f1,color:#ffffff,stroke-width:2px
    classDef db fill:#b45309,stroke:#f59e0b,color:#ffffff,stroke-width:2px
    classDef obs fill:#374151,stroke:#9ca3af,color:#f3f4f6,stroke-dasharray: 5 5

    %% External Actors
    subgraph Clients["External Clients (Roles: DEALER, BUYER, TREASURER)"]
        WebClient["Web / Mobile Client\n(Bearer JWT)"]
        SwaggerBrowser["Developer Browser\n(/swagger-ui.html)"]
    end
    class WebClient,SwaggerBrowser client

    %% Security Provider
    Keycloak["Keycloak (OAuth2 / OIDC)\nRealm: donedeal-realm\nRoles: DEALER | BUYER | TREASURER"]
    class Keycloak infra

    %% Edge Layer
    subgraph Edge["Public Entry Point (Exposed via K8s Ingress)"]
        Gateway["API Gateway (Spring Cloud Gateway MVC :8080)\n• OAuth2 Resource Server (JWT Validation)\n• GatewayRouterFunctions + Resilience4J CB\n• Aggregated Swagger UI (/v3/api-docs/*)"]
    end
    class Gateway gateway

    %% Internal Cluster Boundary
    subgraph InternalNetwork["Internal Microservices Mesh (ClusterIP — No Public Ports)"]
        
        subgraph InventoryDomain["Inventory Domain"]
            InvSvc["inventory-service (:8081)\n• Single & Batch CSV Vehicle Ingestion\n• Paginated Search & Filtering\n• OpenAPI JSON Only (No UI)"]
            Mongo[(MongoDB\navis_inventory\n• vehicles\n• batch_jobs)]
        end

        subgraph PurchaseDomain["Purchase & Locking Domain"]
            PurSvc["purchase-service (:8082)\n• Vehicle Reservation & Locking\n• Treasurer Approval Workflow\n• RestClient + Resilience4J CB/Retry\n• OpenAPI JSON Only (No UI)"]
            MySQL[(MySQL 8 + Flyway\navis_purchase\n• purchases\n• uk_active_vehicle_lock)]
        end

        subgraph Messaging["Event Backbone"]
            Kafka["Apache Kafka (KRaft) +\nConfluent Schema Registry (Avro)\n• batch-upload-topic\n• purchase-events-topic"]
        end

        subgraph NotificationDomain["Notification Domain"]
            NotifSvc["notification-service (:8083)\n• @KafkaListener (Avro Consumer)\n• JavaMailSender"]
            SMTP["Mailtrap / SMTP Server"]
        end
    end
    class InvSvc,PurSvc,NotifSvc service
    class Mongo,MySQL db
    class Kafka,SMTP infra

    %% Observability Stack
    subgraph Observability["Observability Stack (Side-Channel Telemetry)"]
        Prometheus["Prometheus\n(/actuator/prometheus)"]
        Tempo["Grafana Tempo\n(Brave Trace IDs + JDBC Spans)"]
        Loki["Grafana Loki\n(Loki4j Appender)"]
        Grafana["Grafana Dashboards"]
    end
    class Prometheus,Tempo,Loki,Grafana obs

    %% Client & Auth Flows
    WebClient -- "1. Authenticate & Get JWT" --> Keycloak
    WebClient -- "2. REST API + JWT" --> Gateway
    SwaggerBrowser -- "3. Aggregated Docs" --> Gateway
    Gateway -. "Verify Public Keys (JWKS)" .-> Keycloak

    %% Gateway Routing
    Gateway -- "Route /api/v1/inventory/**\n& /v3/api-docs/inventory" --> InvSvc
    Gateway -- "Route /api/v1/purchases/**\n& /v3/api-docs/purchase" --> PurSvc

    %% Service-to-Service Sync
    PurSvc -- "Sync GET Vehicle Price/Details\n(CircuitBreaker + WireMock in tests)" --> InvSvc

    %% Persistence
    InvSvc <--> Mongo
    PurSvc <--> MySQL

    %% Async Event Flows
    InvSvc -- "Publish BatchUploadEvent (Avro)" --> Kafka
    Kafka -- "Consume BatchUploadEvent\n(BulkOps Insert)" --> InvSvc
    PurSvc -- "Publish PurchaseEvent\n(RESERVED / SOLD)" --> Kafka
    Kafka -- "Consume PurchaseEvent\n(Update Vehicle Status)" --> InvSvc
    Kafka -- "Consume PurchaseEvent &\nBatchUploadEvent" --> NotifSvc
    NotifSvc -- "Send Emails" --> SMTP

    %% Observability Flows
    Gateway & InvSvc & PurSvc & NotifSvc -. "Metrics / Traces / Logs" .-> Prometheus & Tempo & Loki
    Prometheus & Tempo & Loki --> Grafana
