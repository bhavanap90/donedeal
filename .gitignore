# --- Build Directories (Recursive across all modules) ---
target/
build/
out/

# Prevent ignoring source code packages named 'target', 'build', or 'out'
!**/src/main/**/target/
!**/src/test/**/target/
!**/src/main/**/build/
!**/src/test/**/build/
!**/src/main/**/out/
!**/src/test/**/out/

# --- Maven & Gradle ---
.mvn/wrapper/maven-wrapper.jar
.gradle/
gradle-app.setting
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# --- Local Secrets & Environment Overrides ---
.env
.env.*
application-local.yml
application-local.properties
application-secret.yml
application-secret.properties

# --- IDEs & Editors ---
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# VS Code
.vscode/

# --- Logs & Temp Files ---
*.log
logs/
*.tmp
*.bak
*.swp
*~

# --- OS Files ---
.DS_Store
Thumbs.db
Desktop.ini


# Docker
docker-setup/docker/
